# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_DOCUMENT_MODEL=openrouter/free
OPENROUTER_REFERER=http://localhost:3001
OPENROUTER_APP_NAME=SupportAI Agent

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=rag_docs

# Supabase API and database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=bot-documents

# Auth/session
AUTH_SESSION_SECRET=replace-with-a-32-byte-random-secret
DEMO_LOGIN_PASSWORD=Password123!
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Outbound email
# The app posts email payloads to this HTTPS endpoint when configured.
# Without this endpoint, emails are logged in development only.
EMAIL_FROM="SupportAI Agent <no-reply@example.com>"
SMTP_HTTP_ENDPOINT=
SMTP_HTTP_TOKEN=

# Meta channel webhooks
# These same credential names are used by the Super Admin and Company Admin
# integration setup forms. Company-specific values are stored server-side.
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=831934aa2087bfe58c17be4058db1cabdd36228c2e64f617
WHATSAPP_ACCESS_TOKEN=store-in-secret-manager
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_VERIFY_TOKEN=e4c05edf340132036e9ed9211fb32a22c9bde2d6a0b07b90
FACEBOOK_PAGE_ACCESS_TOKEN=store-in-secret-manager
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=base64-32-byte-key

# Document processing
DOCUMENT_PROCESSING_TTL_MS=120000
DOCUMENT_PLACEHOLDER_TTL_MS=45000
MAX_UPLOAD_SIZE_MB=10
